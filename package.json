{
  "name": "astrostyle",
  "version": "0.1.0",
  "description": "A CSS/SCSS framework in the ASTROPRISMA style: tokens, layouts and generic components, with a pinch of vanilla JavaScript.",
  "keywords": [
    "css",
    "scss",
    "sass",
    "css-framework",
    "design-tokens",
    "itcss",
    "astroprisma"
  ],
  "homepage": "https://github.com/Cantilux/astrostyle#readme",
  "bugs": "https://github.com/Cantilux/astrostyle/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cantilux/astrostyle.git"
  },
  "license": "MIT",
  "author": "Enrico Cantile",
  "type": "module",
  "sass": "scss/_index.scss",
  "style": "dist/astrostyle.css",
  "exports": {
    ".": {
      "sass": "./scss/_index.scss",
      "style": "./dist/astrostyle.css",
      "default": "./dist/astrostyle.css"
    },
    "./css": "./dist/astrostyle.css",
    "./css/min": "./dist/astrostyle.min.css",
    "./tokens.json": "./dist/tokens.json",
    "./scss/*": "./scss/*",
    "./package.json": "./package.json"
  },
  "files": [
    "scss",
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "lint": "bun run lint:styles && bun run lint:format",
    "lint:styles": "stylelint \"scss/**/*.scss\"",
    "lint:format": "prettier --check .",
    "format": "prettier --write .",
    "changeset": "changeset",
    "check:package": "node scripts/check-package.mjs",
    "release:version": "changeset version",
    "prepublishOnly": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@csstools/selector-specificity": "6.0.1",
    "postcss": "8.5.30",
    "postcss-selector-parser": "7.1.6",
    "prettier": "3.9.10",
    "sass": "1.105.2",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-declaration-strict-value": "1.12.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
